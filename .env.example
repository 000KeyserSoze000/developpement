# =============================================
# ContentPro.fr - Environment Variables Template
# =============================================
# Copy this file to .env and fill in your values

# ---------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ---------------------------------------------
# Supabase Configuration
# ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# ---------------------------------------------
# NextAuth.js Configuration
# ---------------------------------------------
NEXTAUTH_URL="https://contentpro.fr"
NEXTAUTH_SECRET="[GENERATE-RANDOM-SECRET: openssl rand -base64 32]"

# ---------------------------------------------
# AI Configuration (z-ai-web-dev-sdk)
# ---------------------------------------------
# Z_AI_API_KEY="[YOUR-API-KEY-IF-NEEDED]"

# ---------------------------------------------
# Application Configuration
# ---------------------------------------------
NODE_ENV="production"
PORT=3000
